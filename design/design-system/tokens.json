{
  "$comment": "Design tokens for The Third Space. Mirrors constants/design.ts, which is the version the app imports.",
  "color": {
    "ink": "#111827",
    "accent": "#6366F1",
    "accentDeep": "#4F46E5",
    "accentDark": "#4338CA",
    "body": "#374151",
    "muted": "#6B7280",
