        "fill": "#FFEDD5",
        "border": "#FED7AA",
        "ink": "#B45309"
      },
      "warning": {
        "fill": "#FFFBEB",
        "border": "#FDE68A",
        "ink": "#92400E"
      },
      "declined": {
        "fill": "#FEF2F2",
        "border": "#FECACA",
        "ink": "#DC2626"
      },
      "organizer": {
        "fill": "#EEF2FF",
        "border": "#C7D2FE",
        "ink": "#4338CA"
      }
    },
    "accentStar": "#F59E0B",
    "accentSuccess": "#16A34A",
    "accentDanger": "#DC2626"
