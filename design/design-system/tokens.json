  "radius": {
    "pill": 999,
    "feature": 14,
    "control": 12,
    "input": 8,
    "tile": 10
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "gutter": 16
  },
  "type": {
    "family": "system-ui / SF Pro / Roboto",
    "screenTitle": {
      "size": 26,
      "weight": 700
    },
    "eventTitle": {
      "size": 22,
      "weight": 700
    },
    "sectionHeading": {
      "size": 15,
      "weight": 700
    },
    "body": {
      "size": 14,
      "weight": 400
    },
    "meta": {
      "size": 12,
      "weight": 400
    },
    "micro": {
      "size": 11,
      "weight": 600
    }
  },
  "motion": {
    "navFloat": {
      "durationMs": 2000,
      "easing": "ease-in-out",
      "loop": true
    },
    "screenTransition": "slide_from_right"
  },
  "touchTarget": {
    "min": 36,
    "comfortable": 44
  },
  "header": {
    "paddingHorizontal": 16,
    "paddingTop": 16,
    "paddingBottom": 12
