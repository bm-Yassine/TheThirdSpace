# Copy to .env.local and fill in. All EXPO_PUBLIC_* vars are bundled into the
# client, so only ever put publishable values here.

# --- Firebase (safe to expose; these identify the project, they do not grant access) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Google OAuth ---
EXPO_PUBLIC_WEB_CLIENT_ID=
EXPO_PUBLIC_IOS_CLIENT_ID=
EXPO_PUBLIC_ANDROID_CLIENT_ID=

# --- Stripe (publishable key only; the secret key lives in Vercel env vars) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PAYMENTS_API_BASE_URL=/api

# --- Development ---
# Seed the discovery feed with mock events when there is no live data.
EXPO_PUBLIC_USE_MOCK_EVENTS=false
