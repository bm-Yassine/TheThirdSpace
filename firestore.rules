rules_version = '2';

// The Third Space — Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Principles:
//  - Nothing is writable by an anonymous caller.
//  - A document is writable by its owner, or by the organizer of the event it
//    belongs to. Nobody can write to another user's profile.
//  - Event participation counters are the one field group a non-organizer may
//    touch on an event, and only those fields.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function existingEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isEventOrganizer(eventId) {
      return isSignedIn() && existingEvent(eventId).createdBy == request.auth.uid;
    }

    /** Fields changed by this write, compared with what is stored. */
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- users
    // Profiles are readable by any signed-in user so organizer pages and
    // attendee lists can render. Only the owner may write.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId);
      allow delete: if isUser(userId);

      // Private sub-collections: strictly the owner's own data.
      match /favorites/{eventId} {
        allow read, write: if isUser(userId);
      }

      match /createdEvents/{eventId} {
        allow read, write: if isUser(userId);
      }

      match /ratedEvents/{eventId} {
        allow read, write: if isUser(userId);
      }

      // Who this user has blocked. Private to them — a blocked person must not
      // be able to discover that they were blocked.
      match /blocked/{blockedId} {
        allow read, write: if isUser(userId);
      }

      // The user's mirror of their participation. The owner manages it, and
      // the organizer of the event may update its status to record an
      // approval, decline or waitlist promotion.
      match /commitments/{eventId} {
        allow read: if isUser(userId) || isEventOrganizer(eventId);
        allow create, delete: if isUser(userId);
        allow update: if isUser(userId) || isEventOrganizer(eventId);
      }

      // Legacy mirror kept for documents written before the participants
      // sub-collection existed. Owner-only; no longer written to.
      match /joinedEvents/{eventId} {
        allow read, write: if isUser(userId);
      }
    }

    // --------------------------------------------------------------- events
    match /events/{eventId} {
      // Discovery is public — browsing does not require an account.
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;

      // The organizer may edit their event freely. Anyone else may only move
      // the denormalised participation counters, which is what joining,
      // leaving and waitlisting need to do.
      allow update: if isSignedIn() && (
                      resource.data.createdBy == request.auth.uid
                      || changedKeys().hasOnly(
                           ['attendees', 'pendingCount', 'waitlistCount', 'updatedAt']
                         )
                    );

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // ------------------------------------------------------ participants
      match /participants/{participantId} {
        // Visible to the organizer and to the participant themselves.
        allow read: if isSignedIn();

        // You add yourself; you cannot add anybody else.
        allow create: if isUser(participantId)
                      && request.resource.data.uid == request.auth.uid;

        // Participants may update their own row (e.g. payment status); the
        // organizer may update anyone's row to approve or decline them.
        allow update: if isUser(participantId) || isEventOrganizer(eventId);

        // You may withdraw yourself; the organizer may remove anyone. The
        // organizer check tolerates the event already being gone, which happens
        // while an account is being deleted.
        allow delete: if isUser(participantId)
                      || !exists(/databases/$(database)/documents/events/$(eventId))
                      || isEventOrganizer(eventId);
      }
    }

    // -------------------------------------------------------- conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;

      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isSignedIn()
                    && request.auth.uid in conversation().participantIds;

        // You can only send as yourself, into a conversation you belong to.
        allow create: if isSignedIn()
                      && request.auth.uid in conversation().participantIds
                      && request.resource.data.senderId == request.auth.uid;

        // Messages are immutable once sent. The exception is erasure: a user
        // deleting their account may remove their own messages.
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // -------------------------------------------------------------- ratings
    // Readable by anyone signed in, since reputation is computed on read.
    // Document id is `${eventId}_${raterUid}_${rateeUid}`, so one person can
    // leave at most one rating per person per event.
    match /ratings/{ratingId} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
                            && request.resource.data.raterUid == request.auth.uid
                            && request.resource.data.rateeUid != request.auth.uid
                            && ratingId == request.resource.data.eventId + '_'
                                           + request.auth.uid + '_'
                                           + request.resource.data.rateeUid;

      // The rater may withdraw a rating; the person rated may erase one that
      // identifies them, which account deletion depends on.
      allow delete: if isSignedIn()
                    && (resource.data.raterUid == request.auth.uid
                        || resource.data.rateeUid == request.auth.uid);
    }

    // -------------------------------------------------------------- reports
    // Write-only from the client. A reporter can file a report, but nobody can
    // read them back through the app, so a reported user cannot find out who
    // reported them. Moderation happens in the Firebase console or via the
    // Admin SDK, both of which bypass these rules.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.targetId != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------- payments
    // Written by the client on checkout and by the Stripe webhook via the
    // Admin SDK, which bypasses these rules entirely.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.payerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.payerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
